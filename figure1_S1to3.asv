%% script to generate figure 1 
% author: taylor nguyen

clear all;
close all;
clc;

cd('/Users/taynguyen/Dropbox/_phage/github_upload/')

%% load variables
tay4_color = [201, 148, 199] / 255;
kp_color = [223,101,176] ./ 255;

%% figure 1a
% imaging

%% figure 1b
% Ef monoculture + Tay4
% pass 1 (+Tay4), pass 2 (recovery), pass 3 (+Tay4)

% 96-well plate OD600 growth curves
load('_figureData/fig1d_230524_OD_monoculture_1X_MOI.mat', 'mono_1X_MOI')
load('_figureData/fig1d_230524_OD_monoculture_10X_MOI.mat', 'mono_10X_MOI')
load('_figureData/230524_OD_monoculture_heat_killed.mat', 'mono_heat_killed')

% params:
% phage name, passage, column of plate to plot, dataframe, color, format
% use dataframe mono_1X_MOI for tay4 MOI~1 (tay4 conc: 10^9 pfus/mL)

[fig, p] = plot_phage_AUC_comparison("tay4", 1, 3, mono_1X_MOI, tay4_color, "horizontal") % c, p, plate

% get AUC p-value
p 

% save figure
w=4;
h=3;
set(gcf, 'Units', 'Inches', 'Position', [0, 0, w, h], 'PaperUnits', 'Inches', 'PaperSize', [w, h])

fname = "figs/fig1/ef_mono_tay4_pass1";
print(gcf, strcat(fname, '.png'),'-dpng','-r300');
print(gcf, strcat(fname, '.svg'),'-dsvg','-r300');

%% figure 1c
% imaging

%% figure 1d
% SICs + Tay4 (MOI~1) for passages 1-6
% plot Ef and Kp relative abundance

% load 16s ASV relative abundance table
load("fig1_240108_SIC_Ef_resistance_ASV_table.mat", "SIC_res_ASV_relab_table")

% plot average of Ef (top panel) and Kp (bottom panel) 
% plot as 1 2 3 4 5 6/6P (two lines) 

% figure parameters
SIC_shift = [0:12:84];
lw = 1.;

figure
for s = 4:7
    
    Ef_relab_ctrl = [];
    Kp_relab_ctrl = [];
    Ef_relab_phage = [];
    Kp_relab_phage = [];
    Ef_relab_phage_phage = [];
    Kp_relab_phage_phage = [];

    for r = 1:3
        idx2plot = [r+SIC_shift(s):96:576];
        Ef_relab_ctrl(:,r) = SIC_res_ASV_relab_table(idx2plot, ef_idx);
        Kp_relab_ctrl(:,r) = SIC_res_ASV_relab_table(idx2plot, kp_idx);
    
        Ef_relab_phage(:,r) = SIC_res_ASV_relab_table(idx2plot+3, ef_idx);
        Kp_relab_phage(:,r) = SIC_res_ASV_relab_table(idx2plot+3, kp_idx);

        Ef_relab_phage_phage(:,r) = SIC_res_ASV_relab_table(idx2plot+3, ef_idx);
        Kp_relab_phage_phage(:,r) = SIC_res_ASV_relab_table(idx2plot+3, kp_idx);
    end

    % rewrite the 6th passage for 6th passage + Tay4
    for r = 1:3
        idx2plot = [r+SIC_shift(s)+96*6];
        Ef_relab_phage_phage(6,r) = SIC_res_ASV_relab_table(idx2plot+3, ef_idx);
        Kp_relab_phage_phage(6,r) = SIC_res_ASV_relab_table(idx2plot+3, kp_idx);
    end

    % plot Ef (first row)
    subplot(2,4,s-3)

    % plot control
    y = mean(Ef_relab_ctrl, 2);
    sdev = std(Ef_relab_ctrl, [], 2);
    plot(1:6, y, 'o-', 'Color', 'black', 'MarkerFaceColor', 'white', 'linewidth', lw); hold all;
    errorbar(1:6, y, sdev, 'Color', 'black', "LineStyle","none", 'linewidth', lw);

    % plot phage
    y = mean(Ef_relab_phage, 2);
    sdev = std(Ef_relab_phage, [], 2);

    % plot untreated passages with white fill
    plot(2:6, y(2:6), 'o-', 'Color', color_tay4, 'MarkerFaceColor', "white", 'linewidth', lw); hold all;

    % plot phage treated passages with fill
    plot(1, y(1), 'o-', 'Color', color_tay4, 'MarkerFaceColor', color_tay4, 'linewidth', lw); hold all;
    errorbar(1:6, y, sdev, 'Color', color_tay4, "LineStyle","none", 'linewidth', lw);

    % plot phage-phage
    y = mean(Ef_relab_phage_phage, 2);
    sdev = std(Ef_relab_phage, [], 2);

    % plot untreated passages with white fill
    plot(1:5, y(1:end-1), 'o-', 'Color', color_tay4, 'MarkerFaceColor', "white", 'linewidth', lw); hold all;
    plot(1, y(1), 'o', 'Color', color_tay4, 'MarkerFaceColor', color_tay4, 'linewidth', lw); hold all;
    plot(5:6, y(5:6), 'o-', 'Color', color_tay4, 'MarkerFaceColor', "white", 'linewidth', lw); hold all; % change linestyle in illustrator
    plot(6, y(6), 'o', 'Color', color_tay4, 'MarkerFaceColor', color_tay4, 'linewidth', lw); hold all;

    errorbar(1:6, y, sdev, 'Color', color_tay4, "LineStyle","none", 'linewidth', lw);

    xticklabels([[]])
    ylim([0 0.5]);
    xlim([0.5 6.5])

    % plot Kp
    subplot(2,4,s-3+4)

    % plot control
    y = mean(Kp_relab_ctrl, 2);
    sdev = std(Kp_relab_ctrl, [], 2);
    plot(1:6, y, 'o-', 'Color', 'black', 'MarkerFaceColor', 'white', 'linewidth', lw); hold all;
    errorbar(1:6, y, sdev, 'Color', 'black', "LineStyle","none", 'linewidth', lw);
    
    % plot phage
    y = mean(Kp_relab_phage, 2);
    sdev = std(Kp_relab_phage, [], 2);

    % plot untreated passages with white fill
    plot(2:6, y(2:end), 'o-', 'Color', color_tay4, 'MarkerFaceColor', "white",'linewidth', lw); hold all;

    % plot phage treated passages with fill
    plot(1, y(1), 'o-', 'Color', color_tay4, 'MarkerFaceColor', color_tay4,'linewidth', lw); hold all;    
    errorbar(1:6, y, sdev, 'Color', color_tay4, "LineStyle","none",'linewidth', lw);

    % plot phage-phage
    y = mean(Kp_relab_phage_phage, 2);
    sdev = std(Kp_relab_phage_phage, [], 2);

    % plot phage treated passages with fill
    plot(1:5, y(1:5), 'o-', 'Color', color_tay4, 'MarkerFaceColor', "white",'linewidth', lw); hold all;
    plot(1, y(1), 'o-', 'Color', color_tay4, 'MarkerFaceColor', color_tay4,'linewidth', lw); hold all;
    plot(5:6, y(5:6), 'o-', 'Color', color_tay4, 'MarkerFaceColor', "white",'linewidth', lw); hold all; % change linestyle in illustrator
    plot(6, y(6), 'o-', 'Color', color_tay4, 'MarkerFaceColor', color_tay4,'linewidth', lw); hold all;

    errorbar(1:6, y, sdev, 'Color', color_tay4, "LineStyle","none",'linewidth', lw);
    
    xticklabels([])
    xlim([0.5 6.5])
    yline([0 0.1])

end

w=7;
h=3;
set(gcf, 'Units', 'Inches', 'Position', [0, 0, w, h], 'PaperUnits', 'Inches', 'PaperSize', [w, h])

fname = "figs/fig1/ef_mono_tay4_pass1";

fname = strcat(figsdir, "fig1/Entero_ASV_relab_tay4");
print(gcf, strcat(fname, '.png'),'-dpng','-r300');
print(gcf, strcat(fname, '.svg'),'-dsvg','-r300');

